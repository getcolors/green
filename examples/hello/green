#!/usr/bin/env bb
;; hello — the smallest useful green package.
;;
;;   ./green create             # uname ∥ write greeting  →  check (join)
;;   ./green create --dry-run   # uname still runs (read-only); writes are skipped
;;   ./green delete             # remove the greeting file
;;   COLORS_PAR_NAME=agent ./green create
;;
;; Steps call local CLIs and the file system directly. A real package does the
;; same with a cloud CLI or API (`gcloud`, `doctl`, `oci`, an HTTP client):
;; green owns graphs, subworkflows and advice; this application owns its CLI.

(require '[babashka.fs :as fs])

(def script-dir
  (str (fs/parent (fs/canonicalize (if (= "NO_SOURCE_PATH" *file*)
                                     (fs/path (fs/cwd) "green")
                                     *file*)))))

;; Resolve green from this checkout. GREEN_LIB_ROOT points the launcher at
;; another working tree; a standalone package pins a :git/sha instead.
((requiring-resolve 'babashka.deps/add-deps)
 {:deps {'io.github.getcolors/green
         {:local/root (or (System/getenv "GREEN_LIB_ROOT")
                          (str (fs/path script-dir "../..")))}}})

(require '[babashka.cli :as args]
         '[clojure.java.shell :as shell]
         '[clojure.string :as str]
         '[green.cli :as cli]
         '[green.workflow :as wf])

(defn greeting-path
  "The greeting file, resolved against the desired-state file's directory."
  [opts]
  (let [p (fs/path (:greeting-file opts))]
    (str (if (fs/absolute? p)
           p
           (fs/path (fs/parent (:hello/state-file opts)) p)))))

(defn greeting [opts]
  (str "hello, " (:name opts) "\n"))

(defn start-step
  "Application validation; configuration and defaults are prepared by main."
  [opts]
  (let [errors (for [k [:name :greeting-file]
                     :when (str/blank? (str (get opts k)))]
                 (str (name k) " must not be blank (" (cli/par-name k) ")"))]
    (if (seq errors)
      (assoc opts :green/exit 2 :green/err (str/join "; " errors))
      opts)))

(defn uname-step
  "Read-only local CLI call: record the kernel name."
  [opts]
  (let [{:keys [exit out err]} (shell/sh "uname" "-s")]
    (if (zero? exit)
      (assoc opts :hello/kernel (str/trim out))
      (assoc opts :green/exit exit :green/err (str "uname failed: " err)))))

(defn write-step
  "Side effect: write the greeting file."
  [opts]
  (let [path (greeting-path opts)]
    (fs/create-dirs (fs/parent path))
    (spit path (greeting opts))
    (assoc opts :hello/written path)))

(defn check-step
  "Join: merge both branches, read the file back and verify it."
  [opts]
  (let [opts (apply merge opts (:green/branches opts))
        path (greeting-path opts)
        actual (when (fs/exists? path) (slurp path))]
    (if (= (greeting opts) actual)
      (do (println (str (str/trim actual) " (" (:hello/kernel opts) ")"))
          (dissoc opts :green/branches))
      (assoc opts :green/exit 1
                  :green/err (str "unexpected content in " path ": " (pr-str actual))))))

(defn remove-step
  "Side effect: delete the greeting file. Idempotent."
  [opts]
  (fs/delete-if-exists (greeting-path opts))
  opts)

(defn verify-step [opts]
  (if (= (greeting opts) (slurp (greeting-path opts)))
    opts
    (assoc opts :green/exit 1 :green/err "Greeting verification failed")))

(def artifact-workflow
  (wf/workflow {:start :hello/write
                :wire-fn (fn [step _]
                           (case step
                             :hello/write [write-step :hello/verify]
                             :hello/verify [verify-step]))}))

(defn wire-fn
  "The artifact subworkflow runs alongside uname, then both join at check."
  [step run-opts]
  (case [(:hello/event run-opts) step]
    [:create :hello/start] [start-step :hello/uname :hello/artifact]
    [:create :hello/uname] [uname-step :hello/check]
    [:create :hello/artifact] [(wf/step artifact-workflow) :hello/check]
    [:create :hello/check] [check-step]
    [:delete :hello/start] [start-step :hello/remove]
    [:delete :hello/remove] [remove-step]))

(defn report-step
  "Application-owned advice; inherited by the artifact's internal steps."
  [inner opts]
  (let [result (inner opts)]
    (locking *out* (println "<<<" (:green/step opts)))
    result))

(defn skip-write [inner opts]
  (if (:hello/dry-run opts)
    (do (locking *out* (println "dry-run: would run" (:green/step opts))) opts)
    (inner opts)))

(def workflow
  (reduce (fn [workflow step]
            (wf/advice-add workflow step :around :hello/skip skip-write))
          (wf/advice-add-all (wf/workflow {:start :hello/start :wire-fn wire-fn})
                             :around :hello/report report-step)
          [:hello/write :hello/verify :hello/check :hello/remove]))

(defn main [argv]
  (try
    (let [{:keys [args opts]} (args/parse-args (vec argv)
                             {:spec {:file {:alias :f :default "green.yml"}
                                     :dry-run {:coerce :boolean}}
                              :restrict true})
          event (first args)]
      (if-not (and (= 1 (count args)) (#{"create" "delete"} event))
        {:green/exit 2 :green/err "Usage: green create|delete [-f FILE] [--dry-run]"}
        (let [file (str (fs/absolutize (:file opts)))
              state (cli/read-state file (slurp file))]
          (when-not (map? state)
            (throw (ex-info "Desired state must be a map" {})))
          (wf/run workflow
                  (assoc (cli/read-pars (merge {:greeting-file "work/hello.txt"} state))
                         :hello/event (keyword event) :hello/state-file file
                         :hello/dry-run (boolean (:dry-run opts)))))))
    (catch Exception error
      {:green/exit 2 :green/err (ex-message error)})))

(let [{:green/keys [exit err]} (main *command-line-args*)]
  (when err (binding [*out* *err*] (println err)))
  (System/exit (or exit 0)))
