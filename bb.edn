{:paths ["src" "resources" "test" "test-resources"]
 ;; selmer, cheshire and babashka.cli are built into babashka; yamlstar is not,
 ;; so it must be declared here as well as in deps.edn. Keep the version in
 ;; lockstep with deps.edn — it is pinned exactly on purpose.
 :deps {org.yamlstar/yamlstar {:mvn/version "0.1.17"}}
 :tasks
 {docco {:doc "Regenerate docco.html from source comments and curated notes"
         :task (load-file "tasks/docco.clj")}
  test {:doc "Run the test suite under babashka"
        :requires ([clojure.test]
                   [green.advice-test]
                   [green.workflow-test]
                   [green.scaffold-test]
                   [green.cli-test]
                   [green.dry-run-test]
                   [green.progress-test]
                   [green.tofu-test]
                   [green.ansible-test]
                   [green.process-test]
                   [green.yaml-test]
                   [green.zookeeper-test])
        :task (let [{:keys [fail error]}
                    (clojure.test/run-tests 'green.advice-test
                                            'green.workflow-test
                                            'green.scaffold-test
                                            'green.cli-test
                                            'green.dry-run-test
                                            'green.progress-test
                                            'green.tofu-test
                                            'green.ansible-test
                                            'green.process-test
                                            'green.yaml-test
                                            'green.zookeeper-test)]
                (when (pos? (+ fail error))
                  (System/exit 1)))}}}
