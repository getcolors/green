{:paths ["src" "test" "examples/hello/test"]
 ;; yamlstar is not built into babashka, so it must be
 ;; declared here as well as in deps.edn. Keep the version in lockstep with
 ;; deps.edn — it is pinned exactly on purpose.
 :deps {org.yamlstar/yamlstar {:mvn/version "0.1.17"}}
 :tasks
 {docco {:doc "Regenerate docco.html from source comments and curated notes"
         :task (load-file "tasks/docco.clj")}
  test {:doc "Run the test suite under babashka"
        :requires ([clojure.test]
                   [green.advice-test]
                   [green.workflow-test]
                   [green.cli-test]
                   [hello.launcher-test])
        :task (let [{:keys [fail error]}
                    (clojure.test/run-tests 'green.advice-test
                                            'green.workflow-test
                                            'green.cli-test
                                            'hello.launcher-test)]
                (when (pos? (+ fail error))
                  (System/exit 1)))}}}
